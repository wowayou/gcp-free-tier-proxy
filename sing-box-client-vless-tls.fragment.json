{
  "outbounds": [
    {
      "type": "vless",
      "tag": "vless-tls",
      "server": "YOUR_GRAY_CLOUD_DOMAIN",
      "server_port": 443,
      "uuid": "YOUR_VLESS_TLS_UUID",
      "tls": {
        "enabled": true,
        "server_name": "YOUR_CERT_DOMAIN",
        "insecure": false,
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      },
      "connect_timeout": "15s",
      "tcp_fast_open": false,
      "tcp_keep_alive": "1m",
      "tcp_keep_alive_interval": "30s"
    }
  ]
}
